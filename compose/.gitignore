# Your own configuration, with real credentials in it.
.env

# Host-specific compose overrides, layered last by scripts/lib/common.sh.
compose.local.yaml

# Generated by scripts/bootstrap.sh: the participant private key, the
# management API key, and the DID document built from them. Never commit these.
secrets/

# Optional per-service overrides, appended verbatim to config.properties by
# scripts/render-config.sh. Keep them out of version control if they carry
# anything environment-specific.
config/*/extra.properties

# The rendered config.properties, which scripts/render-config.sh writes from
# .env AND into which it inlines the extra.properties above. Ignoring only
# extra.properties would be pointless: whatever you put there is copied here
# on the next `scripts/bootstrap.sh` and committed from this file instead.
#
# They are build artefacts, not sources — each carries a "GENERATED ... do not
# edit" header, `scripts/render-config.sh` writes them and
# `scripts/render-config.sh --check` verifies them. `scripts/up.sh` runs
# bootstrap first, so they always exist before `docker compose up`; if you
# drive compose by hand, run scripts/render-config.sh once beforehand.
config/*/config.properties
