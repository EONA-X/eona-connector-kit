# =============================================================================
# EONA-X participant connector — compose configuration
# =============================================================================
#
#   cp .env.example .env    then edit, then run ../scripts/up.sh
#
# Out of the box this file describes a self-contained local evaluation: bundled
# PostgreSQL, bundled dev-mode Vault, a did:web that only resolves inside the
# compose network, and no dataspace authority. It boots, the management API
# answers, and the smoke test passes. It is NOT a deployment.
#
# Every value that would tie the stack to a cloud, a registry or a cluster is a
# variable here. Nothing is hardcoded in compose.yaml.
#
# FILE FORMAT. This file is read twice: by Docker Compose, and by the scripts in
# ../scripts, which source it as shell. Keep it to plain KEY=value lines.
# No command substitution, no multi-line values, no references to other
# variables. Quote a value only if it contains spaces, and then use double
# quotes. Values must not contain "#" (Compose treats it as a comment).


# =============================================================================
# 1. IMAGES
# =============================================================================
# The connector images are not published to a public registry. Either build
# them yourself from the dataspace-ecosystem source —
#
#     ./gradlew dockerize
#
# which produces localhost/local/<launcher>:latest — or leave the public defaults below, or set
# these three to wherever your organisation pushes them. `./gradlew dockerize
# -PregistryHost=<host> -PregistryNs=<ns> -PimageTags=<tag>` uses the same
# three parts.
#
# EDC_IMAGE_REGISTRY CANNOT BE BLANK. compose composes the reference as
# <registry>/<namespace>/<name>:<tag>, and an empty registry would leave a
# leading slash, so an empty value falls back to "localhost". If your images
# live in a bare Docker Hub namespace (acme/control-plane-…), either write it
# as EDC_IMAGE_REGISTRY=docker.io with EDC_IMAGE_NAMESPACE=acme — which
# resolves to the same image — or use the three *_IMAGE overrides below. (The
# Helm chart does allow an empty registry: it omits the host entirely.)
EDC_IMAGE_REGISTRY=ghcr.io
EDC_IMAGE_NAMESPACE=eona-x/dataspace
# Upstream tags are timestamps (YYYYMMDD-HHMM), not semantic versions. Pin an
# exact tag for anything you care about; "latest" is for local builds only.
EDC_IMAGE_TAG=latest

# Full per-service overrides, if the three parts above do not describe your
# naming. Leave empty to use registry/namespace/tag.
#CONTROL_PLANE_IMAGE=
#DATA_PLANE_IMAGE=
#IDENTITY_HUB_IMAGE=

# missing | always | never. "missing" suits locally built images: compose will
# not try to pull something you just built. Use "always" against a registry.
EDC_IMAGE_PULL_POLICY=missing

# Bundled datastore images. Pinned rather than :latest on purpose.
POSTGRES_IMAGE=postgres:16-alpine
VAULT_IMAGE=hashicorp/vault:1.20.4


# =============================================================================
# 2. PARTICIPANT IDENTITY
# =============================================================================
# A short slug for this participant. Used for container/component names only —
# never as a Vault alias (bare participant names collide in a shared Vault).
PARTICIPANT_ID=participant

# This connector's DID. It is the participant id, the STS client id, the issuer
# id, and the subject of every credential. Everything else is derived from it.
#
# The default resolves only inside the compose network: did:web maps
#   did:web:identity-hub%3A8383:api:did
# to
#   http://identity-hub:8383/api/did/did.json
# which the identity-hub serves itself. That is enough for a local evaluation
# and for the smoke test, and it needs no DNS, no TLS and no reverse proxy.
#
# For a connector other participants must reach, use a DID on a hostname you
# control, e.g.
#   PARTICIPANT_DID=did:web:connector.example.org:acme:ih:did
# which must resolve to https://connector.example.org/acme/ih/did/did.json.
# You supply the reverse proxy that maps that path onto the identity-hub's DID
# API (port 8383, base path /api/did). See section 5.
PARTICIPANT_DID=did:web:identity-hub%3A8383:api:did

# base64url of PARTICIPANT_DID with no padding. It is embedded in the DID
# document's credential-service URL and in every Identity API path. Compose
# cannot compute it, so it is spelled out here — ../scripts/bootstrap.sh checks
# that it matches PARTICIPANT_DID and prints the right value if it does not.
#   printf '%s' "$PARTICIPANT_DID" | base64 | tr -d '\n=' | tr '+/' '-_'
PARTICIPANT_DID_B64=ZGlkOndlYjppZGVudGl0eS1odWIlM0E4MzgzOmFwaTpkaWQ

# Whether did:web resolution uses https. MUST be true for any real deployment.
# false only for a plain-HTTP local run like the default above.
DID_WEB_USE_HTTPS=false

# Elliptic curve for the participant key pair generated by ../scripts/gen-keys.sh.
# prime256v1 (P-256, ES256) is what EDC deployments use. Changing it after the
# DID document has been published invalidates every signature counterparties
# have already seen.
KEY_CURVE=prime256v1

# Vault aliases for the participant key pair. These are pointers, not secrets,
# so they are safe in config. The same pair is used by the identity-hub (STS
# signing, DID proofs) and by the data-plane (transfer-proxy tokens).
VAULT_ALIAS_PRIVATE_KEY=participant-signing-key
VAULT_ALIAS_PUBLIC_KEY=participant-signing-key-pub

# Vault alias of the STS client secret the control-plane authenticates with.
# The identity-hub MINTS this secret into Vault when it creates the participant
# context on its first successful boot; nothing else creates it. The name below
# is the convention the identity-hub uses, so leave it alone unless you know
# otherwise.
STS_CLIENT_SECRET_ALIAS=did:web:identity-hub%3A8383:api:did-sts-client-secret

# Set to true for ONE boot to make the identity-hub delete and recreate its
# participant context. That re-mints the STS client secret — the recovery path
# after the bundled dev-mode Vault has lost its contents. It also DESTROYS the
# stored credentials and key-pair records for this participant, so every
# credential has to be requested from the issuer again. Set back to false
# immediately afterwards.
IH_SUPERUSER_FORCE_RECREATE=false


# =============================================================================
# 3. DATASPACE
# =============================================================================
# The dataspace authority's DID. The control-plane will NOT START without it:
# the catalog-filtering extension declares it required. It is the audience for
# participant-catalog requests.
#
# For a standalone evaluation with no authority, set it to this participant's
# own DID (the default below) so the runtime boots. Replace it with the real
# authority DID before talking to anyone.
AUTHORITY_DID=did:web:identity-hub%3A8383:api:did

# Issuers whose verifiable credentials this connector accepts, as
# "alias=did" pairs separated by spaces or commas. Rendered into
# config/control-plane/config.properties as edc.iam.trusted-issuer.<alias>.id.
#
# In a real dataspace this lists the authority (which issues the membership
# credential) and every peer participant whose credentials you verify:
#   TRUSTED_ISSUERS="authority=did:web:example.org:authority:ih:did peer=did:web:example.org:peer:ih:did"
#
# A malformed entry fails the whole boot — there is no per-issuer degradation.
TRUSTED_ISSUERS="self=did:web:identity-hub%3A8383:api:did"


# =============================================================================
# 4. POSTGRESQL
# =============================================================================
# The bundled instance is created from these values. To use your own, set
# POSTGRES_HOST/PORT to it and start with the external override:
#   docker compose -f compose.yaml -f compose.external-datastores.yaml up -d
#
# All three runtimes share one database on purpose: the data-plane's consumer
# gateway reads EDR rows the control-plane writes. Splitting them breaks data
# consumption. The migration barrier (section 8) is what makes sharing safe.
#
# What an external database must provide: one empty database and a role with
# schema-owner DDL rights — Flyway creates, drops and alters tables at boot.
# A read-write-only grant will not start. No seed SQL is needed.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=edc
POSTGRES_USER=edc
# CHANGE THIS. It is the database password for every runtime.
POSTGRES_PASSWORD=change-me-postgres

# Appended verbatim to the JDBC URL. Empty for the bundled instance (no TLS).
# A managed database will usually want "?sslmode=require".
POSTGRES_JDBC_PARAMS=

# Connections each runtime keeps open. Three runtimes share one instance, so
# the real budget is three times this. Managed databases often cap this low.
DB_POOL_MAX_TOTAL=5


# =============================================================================
# 5. HASHICORP VAULT
# =============================================================================
# !!! THE BUNDLED VAULT RUNS IN DEV MODE AND IS NOT FOR PRODUCTION. !!!
# Dev mode means: storage in memory, no TLS, auto-unseal, and the fixed root
# token below. Everything is lost when the container restarts — including the
# STS client secret, which is NOT re-minted on a later boot because the
# participant context already exists in PostgreSQL. If that happens, set
# IH_SUPERUSER_FORCE_RECREATE=true for one boot (section 2), or start clean
# with ../scripts/teardown.sh --volumes.
#
# For production: run Vault yourself with persistent storage, TLS and a scoped
# policy, set VAULT_URL/VAULT_TOKEN to it, and use the external override. The
# token below must then be a token restricted to this connector's secret path,
# not a root token. EDC 0.15 also supports AppRole
# (edc.vault.hashicorp.clientid/.clientsecret/.tokenurl) as an alternative.
VAULT_URL=http://vault:8200
# CHANGE THIS for anything but a throwaway local run.
VAULT_TOKEN=change-me-vault-root-token

# KV v2 mount and optional per-participant sub-folder. An alias resolves to
# <VAULT_SECRET_PATH>/data/[<VAULT_FOLDER>/]<alias>, and EDC reads the value out
# of the field named "content".
#
# CAVEAT: the per-participant vault-config that the runtimes seed for themselves
# hardcodes /v1/secret and no folder. A non-default mount works for the default
# vault client and silently does not for that path, so leave these alone unless
# you have verified the behaviour on your EDC version.
VAULT_SECRET_PATH=/v1/secret
VAULT_FOLDER=

VAULT_HEALTH_PATH=/v1/sys/health
VAULT_HEALTH_CHECK_ENABLED=true
VAULT_HEALTH_CHECK_STANDBY_OK=true

# Token renewal. Must stay false for a root token, which has no TTL to renew.
VAULT_TOKEN_SCHEDULED_RENEW_ENABLED=false
VAULT_TOKEN_RENEW_BUFFER=30
VAULT_TOKEN_TTL=300

# Where the SCRIPTS reach Vault and PostgreSQL. The connectors use VAULT_URL and
# POSTGRES_HOST over the compose network; the scripts run on your host and go
# through the published ports. Both are derived automatically — set them only
# when your host reaches the datastore at a different address than the
# connectors do (an SSH tunnel, a bastion, a split-horizon DNS).
#VAULT_ADDR_HOST=http://127.0.0.1:8200
#POSTGRES_HOST_ADDR=127.0.0.1
#POSTGRES_PORT_ADDR=5432


# =============================================================================
# 6. PUBLIC URLS — what peers see
# =============================================================================
# In Kubernetes these come from an ingress. In compose there is no such thing:
# you put your own reverse proxy in front and tell the connector what URL it
# ended up with. These values are baked into the DID document and into every
# EDR, so they must be the addresses a counterparty can actually reach.
#
# The defaults are compose service names, which only work inside this network —
# right for a local evaluation, useless to anyone else.
#
# A real deployment needs four routes on a host you control, with TLS:
#   <public>/<...>/dsp          -> control-plane:8282  (DSP, peer connectors)
#   <public>/<...>/public       -> data-plane:8181     (provider data endpoint)
#   <public>/<...>/credentials  -> identity-hub:8282   (credential service)
#   <public>/<...>/did          -> identity-hub:8383   (did:web document)
# and NOTHING routed to the management API (control-plane:8181), the identity
# API (identity-hub:8181) or any 8080 health port.
PUBLIC_DSP_URL=http://control-plane:8282/api/dsp
PUBLIC_DATAPLANE_PUBLIC_URL=http://data-plane:8181/api/public
PUBLIC_CREDENTIALS_URL=http://identity-hub:8282/api/credentials
# Base URL of the DID API. ../scripts/did-document.sh checks it against what
# PARTICIPANT_DID actually resolves to and complains if they disagree — a
# mismatch means counterparties cannot resolve your DID, which is an obscure
# failure to debug from the logs.
PUBLIC_DID_URL=http://identity-hub:8383/api/did

# Internal service-to-service URLs. Change only if you rename services.
STS_TOKEN_URL=http://identity-hub:8484/api/sts/token
DPF_SELECTOR_URL=http://control-plane:8383/api/control/v1/dataplanes


# =============================================================================
# 7. API EXPOSURE AND AUTHENTICATION
# =============================================================================
# Host interface for the administrative and health ports. Keep it on loopback:
# the management API and, especially, the identity API are powerful.
BIND_ADDRESS=127.0.0.1

# Host interface for the four ports a counterparty must reach (DSP, data-plane
# public, credential service, DID). Set to 0.0.0.0 when a reverse proxy on this
# host forwards to them, or leave on loopback for a purely local evaluation.
PUBLIC_BIND_ADDRESS=127.0.0.1

# Published host ports. Every service uses 8080/8181/8282/8383 internally, so
# they are remapped here to avoid collisions — the two bundled datastores
# included. Left on the standard 5432/8200 they would refuse to start on the
# single most common developer host, the one already running a PostgreSQL:
# compose fails with "port is already allocated" before any of this kit's own
# diagnostics get a chance to say anything useful.
#
# Only VAULT_HOST_PORT is load-bearing — scripts/seed-vault.sh reaches the
# bundled Vault through it. The Postgres mapping is a convenience for pointing
# your own psql at the evaluation database; the kit's helpers go through
# `docker compose exec` instead.
POSTGRES_HOST_PORT=15432
VAULT_HOST_PORT=18200
CP_DEFAULT_HOST_PORT=18080
CP_MANAGEMENT_HOST_PORT=18181
CP_PROTOCOL_HOST_PORT=18282
DP_DEFAULT_HOST_PORT=28080
DP_PUBLIC_HOST_PORT=28181
DP_DATA_HOST_PORT=28282
IH_DEFAULT_HOST_PORT=38080
IH_IDENTITY_HOST_PORT=38181
IH_CREDENTIALS_HOST_PORT=38282
IH_DID_HOST_PORT=38383
IH_STS_HOST_PORT=38484

# Protect the management API with a static bearer token, resolved from Vault at
# boot and sent by callers as the "x-api-key" header. ../scripts/bootstrap.sh
# generates the key and stores it in Vault and in compose/secrets/.
#
# The reference Kubernetes deployment leaves this off and relies on the API not
# being routed publicly. This kit defaults it on.
MANAGEMENT_API_AUTH_ENABLED=true
MANAGEMENT_API_KEY_ALIAS=management-api-key

# NOTE — the Identity API on the identity-hub (port 8181) CANNOT be protected
# this way: this build of the image deliberately excludes the identity-hub
# authentication and authorization modules, so that API is unauthenticated at
# the pod and anyone who reaches it can create or delete participant contexts
# and read credentials. Keep it on loopback or behind your own gateway.

# CORS. Off by default. "*" headers on an authenticated API is not a posture to
# default to; set these only for a browser-based client you control.
CORS_ENABLED=false
CORS_HEADERS="Origin, Content-Type, Accept, Authorization"


# =============================================================================
# 8. MIGRATIONS AND BOOT BUDGET
# =============================================================================
# Schema migrations run in-process at boot, before the runtime serves any HTTP.
# There is no migration job and no init container: that is by design.
MIGRATION_ENABLED=true

# Flyway lock retries, one per second, so effectively a seconds budget. The
# runtimes serialise on this lock, so the last to boot waits for the others.
MIGRATION_LOCK_RETRY_COUNT=240

# THE CROSS-SERVICE SETTING. Signal keys of every migration-contributing
# runtime sharing the database, this one included, verbatim. It exists because
# the shared migration reshapes edc_lease destructively while the other
# runtimes' baselines still create foreign keys into it.
#
# Because the runtimes must SIGNAL EACH OTHER, they have to be running at the
# same time. That is why compose.yaml starts all three together instead of
# chaining them — chaining would deadlock. Read the note at the top of
# compose.yaml before changing any depends_on.
#
# Clear this ONLY if each runtime gets its own database.
MIGRATION_BARRIER_EXPECTED_MODULES="Control Plane Database Migration,Data Plane Database Migration,Identity Hub Database Migration"
MIGRATION_BARRIER_TIMEOUT_SECONDS=300

# How long compose lets a runtime boot before its healthcheck failures start to
# count. Keep it above MIGRATION_BARRIER_TIMEOUT_SECONDS.
EDC_HEALTHCHECK_START_PERIOD=360s


# =============================================================================
# 9. TUNING
# =============================================================================
# Idle wait between state-machine iterations, in milliseconds. Lower is more
# responsive and costs more database round-trips.
NEGOTIATION_STATE_MACHINE_WAIT_MILLIS=2000
TRANSFER_STATE_MACHINE_WAIT_MILLIS=2000
POLICY_MONITOR_STATE_MACHINE_WAIT_MILLIS=5000
DATAPLANE_STATE_MACHINE_WAIT_MILLIS=5000
# Threads serving the consumer data gateway on the data-plane's /api/data.
DATAPLANE_CONSUMER_GATEWAY_THREAD_POOL=5


# =============================================================================
# 10. COMPOSE
# =============================================================================
# Container and network name prefix. Change it to run two connectors side by
# side on one host (they will also need different host ports).
COMPOSE_PROJECT_NAME=eonax-connector
